# ---- server ----
NODE_ENV=development
PORT=5000

# ---- database ----
# Local:  mongodb://127.0.0.1:27017/mobile-shop
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mobile?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/mobile-shop"

# How long to wait for the cluster before giving up on one attempt (ms).
DB_TIMEOUT_MS=15000

# Optional. Only used if this PC's own DNS cannot resolve the Atlas SRV record.
DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- auth ----
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Must match AUTH_BRIDGE_SECRET in frontend/.env.local
OAUTH_SHARED_SECRET=replace-with-a-long-random-string

# ---- cors ----
# Comma separated. Add your deployed frontend domain here.
CLIENT_URLS=http://localhost:3000,https://your-frontend.vercel.app
