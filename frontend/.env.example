# ------------------------------------------------------------------
#  API
# ------------------------------------------------------------------
# The Express API, including the /api prefix.
# Local:  http://localhost:5000/api
# Vercel: https://your-backend.vercel.app/api   (or Render/Railway URL)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Used for canonical URLs, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------
#  Auth.js (NextAuth v5)
# ------------------------------------------------------------------
# Generate with:  npx auth secret     (or)
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-me-with-a-random-32-byte-secret

# Only needed if the deployment URL is not detected automatically.
# AUTH_URL=http://localhost:3000

# ---- Google sign-in ----
# 1. https://console.cloud.google.com/apis/credentials
# 2. Create OAuth client ID → Web application
# 3. Authorised JavaScript origins:
#      http://localhost:3000
#      https://your-site.vercel.app
# 4. Authorised redirect URIs:
#      http://localhost:3000/api/auth/callback/google
#      https://your-site.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret

# Must match OAUTH_SHARED_SECRET in backend/.env — it lets this app exchange a
# verified Google identity for a backend token. Never expose it to the browser.
AUTH_BRIDGE_SECRET=replace-me-with-another-long-random-string
